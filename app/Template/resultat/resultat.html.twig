{% extends "base.html.twig" %}

{% block title %}{{ titre }}{% endblock %}

{% block content %}
<h1>{{ titre }}</h1>
    {% if ville_info is not null %}
            <p>
                Provenant de {{ville_info}}
            </p>
    {% endif %}
    {% if prenom_info is not null %}
            <p>
                Votre prenom est {{prenom_info}}
            </p>
    {% endif %}
    {% if nom_info is not null %}
            <p> 
                Votre nom est {{nom_info}}
            </p>
    {% endif %}
    <a href="/lesvilles"> Retour </a>
{% endblock %}